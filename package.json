{
  "name": "panda-control",
  "version": "0.1.5",
  "description": "A free Extrusion Therapy workshop tool for managing installed BIQU Panda accessories.",
  "desktopName": "panda-control",
  "author": "Extrusion Therapy",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "app": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs",
    "pack:mac": "npm run build && npm run test && electron-builder --mac dir --arm64 --publish never",
    "dist:mac": "zsh scripts/build-release-mac.sh",
    "dist:win": "npm run build && npm run test && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "npm run build && npm run test && electron-builder --linux AppImage --x64 --publish never && bash scripts/build-linux-deb-native.sh",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "43.8.3",
    "electron-builder": "26.15.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.5"
  },
  "build": {
    "afterPack": "scripts/after-pack.cjs",
    "appId": "therapy.extrusion.pandacontrol",
    "productName": "Panda Control",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist/client/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "docs/THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "identity": "C8745B268B6DDD555155EA2F4D0CED3043BE6E3F",
      "sign": "scripts/sign-mac.cjs",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Panda Control uses your local network to find and manage Panda devices that are already configured."
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon-1024.png",
      "executableName": "panda-control",
      "artifactName": "Panda-Control-${version}-Linux-${arch}.${ext}",
      "maintainer": "Extrusion Therapy",
      "syncDesktopName": true
    },
    "deb": {
      "packageName": "panda-control"
    },
    "dmg": {
      "title": "Panda Control ${version}",
      "contents": [
        {
          "x": 150,
          "y": 180
        },
        {
          "x": 500,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
