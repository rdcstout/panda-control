{
  "name": "panda-control",
  "version": "0.1.2",
  "description": "A free Extrusion Therapy workshop tool for managing installed BIQU Panda accessories.",
  "author": "Extrusion Therapy",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "app": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs",
    "pack:mac": "npm run test && npm run build && electron-builder --mac dir --arm64",
    "dist:mac": "zsh scripts/build-release-mac.sh",
    "dist:win": "npm run test && npm run build && electron-builder --win nsis --x64",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "^43.2.0",
    "electron-builder": "25.1.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.3"
  },
  "build": {
    "afterPack": "scripts/after-pack.cjs",
    "appId": "therapy.extrusion.pandacontrol",
    "productName": "Panda Control",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist/client/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "identity": "Roger Stout (W3WPVL2V32)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Panda Control uses your local network to find and manage Panda devices that are already configured."
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico"
    },
    "dmg": {
      "title": "Panda Control ${version}",
      "contents": [
        {
          "x": 150,
          "y": 180
        },
        {
          "x": 500,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
